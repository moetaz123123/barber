PORT=3001
NODE_ENV=development

# URL publique de votre projet Supabase (Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clé "anon" / "publishable" — pas la service_role
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Clé service_role — SECRET, jamais dans le frontend React
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Origine autorisée pour CORS (URL du frontend Vite en local)
CLIENT_ORIGIN=http://localhost:5173

# Fuseau horaire métier (doit correspondre à booking_settings.timezone)
BUSINESS_TIMEZONE=Africa/Tunis

# Notification des nouvelles réservations par Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=moetazbenameur3@gmail.com
SMTP_PASSWORD=your_gmail_app_password
NOTIFICATION_EMAIL=moetazbenameur3@gmail.com

# Lien du bouton dans l’e-mail (localhost uniquement pour le développement local)
ADMIN_APPOINTMENTS_URL=http://localhost:5173/admin/rendez-vous
